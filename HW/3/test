def input_(msg):
    input_data = input(msg)
    if not input_data.isdigit(): return input_("Вы ввели не число или оно не является целым. Введите целое число: ")
    if input_data == int and 100 <= input_data <= 999 and input_data % 2 == 0 and input_data % 3 == 0: return input_("Ваше число удовлетворяет условиям. Введите число:")
    else:
        return input_("Ваше число не удовлетворяет условиям. Введите число:")
print(input_("Введите целое число: "))
